---
import ContentPanel from '@astrojs/starlight/components/ContentPanel.astro';

const { entry } = Astro.locals.starlightRoute;
const { adrStatus, supersededBy } = entry.data;
const isAdr = adrStatus !== undefined;
const badgeLabel =
  adrStatus === 'superseded' ? `Superseded by ${supersededBy}` : adrStatus === 'accepted' ? 'Accepted' : 'Trial';
const badgeVariant = adrStatus === 'accepted' ? 'success' : adrStatus === 'trial' ? 'note' : 'caution';
---

<ContentPanel>
  {isAdr && (
    <p class="adr-status-line">
      <span class={`adr-badge adr-badge-${badgeVariant}`}>{badgeLabel}</span>
    </p>
  )}
  <slot />
</ContentPanel>

<style>
  .adr-status-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .adr-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.15rem 0.6rem;
    border: 1px solid transparent;
  }
  .adr-badge-note {
    /* Trial — the birth state of every ADR (blue block system: Azure/Sky). */
    background: color-mix(in srgb, #1fa7ff 18%, transparent);
    color: #0b7fe0;
    border-color: color-mix(in srgb, #1fa7ff 45%, transparent);
  }
  :global([data-theme='dark']) .adr-badge-note {
    background: color-mix(in srgb, #4cc9ff 15%, transparent);
    color: #4cc9ff;
    border-color: color-mix(in srgb, #4cc9ff 40%, transparent);
  }
  .adr-badge-success {
    /* Accepted — immutable, promoted by the project owner. */
    background: color-mix(in srgb, #0b3fb0 14%, transparent);
    color: #0b3fb0;
    border-color: color-mix(in srgb, #0b3fb0 45%, transparent);
  }
  :global([data-theme='dark']) .adr-badge-success {
    background: color-mix(in srgb, #1fa7ff 15%, transparent);
    color: #1fa7ff;
    border-color: color-mix(in srgb, #1fa7ff 40%, transparent);
  }
  .adr-badge-caution {
    /* Superseded — kept for the record, replaced by a newer ADR. Uses the
       theme-relative text and border tokens (gray-6 is a panel background
       token, not a legible text color). */
    background: color-mix(in srgb, #101826 8%, transparent);
    color: var(--sl-color-text);
    border-color: var(--sl-color-gray-3);
  }
</style>
