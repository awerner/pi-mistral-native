{
  "name": "pi-mistral-native",
  "version": "0.1.3",
  "description": "Native Mistral provider extension for the pi coding agent: chat completions with block-array thinking, model catalog, server-side tools and knowledge APIs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awerner/pi-mistral-native.git"
  },
  "homepage": "https://awerner.github.io/pi-mistral-native/",
  "bugs": {
    "url": "https://github.com/awerner/pi-mistral-native/issues"
  },
  "type": "module",
  "main": "dist/extensions/mistral.js",
  "files": [
    "dist/extensions",
    "assets/banner.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "mistral",
    "ai",
    "llm",
    "provider"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "dist/extensions/*.js"
    ],
    "image": "https://raw.githubusercontent.com/awerner/pi-mistral-native/main/assets/banner.png"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  }
}
